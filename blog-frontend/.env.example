# Backend API base URL (leave empty to use Vite proxy in dev)
VITE_API_URL=

# Site
VITE_SITE_NAME=Horizon Notes
VITE_SITE_URL=http://localhost:5173
VITE_DEFAULT_LOCALE=en

# Weather (Open-Meteo) — default Moscow
VITE_WEATHER_LAT=55.7558
VITE_WEATHER_LON=37.6173
VITE_WEATHER_LABEL=Moscow

# Currency (exchangerate.host)
VITE_CURRENCY_BASE=USD
VITE_CURRENCY_SYMBOLS=EUR,GBP,RUB,JPY

# Google AdSense (optional)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# exchangerate.host access key (optional, required by some plans)
VITE_EXCHANGERATE_KEY=
