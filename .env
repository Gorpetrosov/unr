# Copy to .env and adjust as needed for docker compose

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blog_db
POSTGRES_PORT=5433

API_PORT=4000
FRONTEND_PORT=5173

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:4000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

VITE_SITE_NAME=Horizon Notes
VITE_SITE_URL=http://localhost:5173
VITE_DEFAULT_LOCALE=en
