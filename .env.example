# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL). docker-compose.yml publishes Postgres on host port 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/blog_db?schema=public"
POSTGRES_PORT=5433

# JWT (secrets must be at least 16 characters; use long random values in production,
# e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins). In development every origin is allowed.
# 5173 / 5174 = gp-media-front and gp-media-admin Vite dev servers.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Redis (BullMQ email queue). Set REDIS_ENABLED=true when Redis is running;
# with false, emails are sent in-process.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_ENABLED=false

# Transactional email via Resend (https://resend.com — free tier).
# Leave RESEND_API_KEY empty to log emails to the API console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=Horizon Notes <onboarding@resend.dev>
# Public frontend URL (newsletter confirm/unsubscribe redirects)
PUBLIC_SITE_URL=http://localhost:5173
# Public URL of this API (used in confirmation links inside emails)
PUBLIC_API_URL=http://localhost:4000

# Admin seed credentials (used by `npm run db:seed`; re-running the seed resets the password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Rate limiting (window in ms, max requests per IP per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
